{
  "name": "@uxland/lit-mixins",
  "version": "1.0.2",
  "description": "Lit Mixins",
  "author": "UXLand <dev@uxland.es>",
  "license": "BSD-4-Clause",
  "homepage": "https://github.com/uxland/lit/tree/master/packages/lit-mixins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxland/lit.git",
    "directory": "packages/lit-mixins"
  },
  "bugs": {
    "url": "https://github.com/uxland/lit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@uxland/event-aggregator": "^1.0.1",
    "@uxland/lit-redux-connect": "workspace:^",
    "@uxland/lit-utilities": "workspace:^",
    "@uxland/localization": "^1.0.1",
    "@uxland/routing": "^1.0.5",
    "@uxland/utilities": "^1.0.1",
    "lit": "^2.7.4",
    "redux": "^4.1.0"
  }
}
