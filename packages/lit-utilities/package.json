{
  "name": "@uxland/lit-utilities",
  "version": "1.0.0",
  "description": "Lit Utilities",
  "author": "UXLand <dev@uxland.es>",
  "license": "BSD-4-Clause",
  "homepage": "https://github.com/uxland/lit/tree/master/packages/lit-utilities#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxland/lit.git",
    "directory": "packages/lit-utilities"
  },
  "bugs": {
    "url": "https://github.com/uxland/lit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "web-test-runner"
  },
  "dependencies": {
    "@uxland/utilities": "^1.0.5"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "lit": "^3.3.0"
  }
}
