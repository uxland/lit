{
  "name": "@uxland/lit",
  "description": "UXLand Lit Libraries",
  "author": "UXLand <dev@uxland.es>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxland/lit.git"
  },
  "bugs": {
    "url": "https://github.com/uxland/lit/issues"
  },
  "homepage": "https://github.com/uxland/lit#readme",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.11",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^3.0.3",
    "@open-wc/testing": "^5.0.0",
    "@types/sinon": "^22.0.2",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "lodash": "^4.18.1",
    "redux": "^4.2.1",
    "rimraf": "^6.1.4",
    "sinon": "^22.1.0",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
